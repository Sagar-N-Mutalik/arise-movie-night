# ==========================================
# NIE PASS / ArISE Movie Night 2026 - Backend Config
# ==========================================

# Database
DATABASE_URL=sqlite:///./nie_pass.db

# Email / SMTP Configuration (Required for sending OTP to entered email)
# For Gmail: Use smtp.gmail.com, port 587, your email, and a 16-character App Password.
# How to get Gmail App Password:
# 1. Enable 2-Step Verification in Google Account -> Security
# 2. Search "App passwords" -> Create one for "Mail" -> Paste the 16 letters below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Email format pattern (defaults to valid email formats, or set to strict institution email if needed)
# EMAIL_REGEX_PATTERN=^[\w\.-]+@nie\.ac\.in$

# Razorpay Payment Gateway
# Dashboard: https://dashboard.razorpay.com  →  Account & Settings → API Keys
# Use Test keys (rzp_test_...) while developing. Switch to Live keys (rzp_live_...) for production.
# KEY_ID is public (also sent to the browser). KEY_SECRET must never leave the backend.
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
# Webhooks: Dashboard → Account & Settings → Webhooks
# URL: https://YOUR_PUBLIC_HOST/api/webhooks/razorpay
# Events: payment.captured, payment.failed, order.paid
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere
